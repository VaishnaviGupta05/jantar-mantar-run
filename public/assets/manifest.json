body {
  margin: 0;
  font-family: Inter, 'Segoe UI', sans-serif;
  background: radial-gradient(circle at top, #1e2a4a 0%, #111827 30%, #090d15 100%);
  color: #f8f7f2;
  overflow: hidden;
}

* {
  box-sizing: border-box;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

#app {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(17, 24, 39, 0.94), rgba(4, 8, 15, 0.95));
}

.ui-layer {
  position: absolute;
  inset: 0;
  z-index: 20;
  pointer-events: none;
}

.screen {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: opacity 220ms ease, visibility 220ms ease;
}

.screen.visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.panel {
  width: min(94vw, 1120px);
  min-height: min(80vh, 680px);
  background: rgba(11, 17, 30, 0.72);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 24px;
  backdrop-filter: blur(18px);
  box-shadow: 0 30px 80px rgba(3, 7, 18, 0.65);
  overflow: hidden;
}

.hero {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  min-height: 100%;
}

.hero-copy {
  padding: clamp(24px, 4vw, 48px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  background: linear-gradient(180deg, rgba(20, 29, 47, 0.8), rgba(10, 13, 20, 0.7));
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #f9b657;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  font-size: 0.8rem;
  font-weight: 700;
}

.logo-mark {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: linear-gradient(135deg, #f6c86a, #d95c40);
  display: grid;
  place-items: center;
  color: #1d2431;
  font-weight: 900;
}

h1 {
  margin: 18px 0 12px;
  font-size: clamp(2.4rem, 4vw, 5rem);
  line-height: 0.95;
  letter-spacing: -0.06em;
}

.subtitle {
  max-width: 540px;
  font-size: 1.05rem;
  color: rgba(240, 241, 247, 0.8);
  line-height: 1.6;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.primary-btn,
.secondary-btn,
.ghost-btn,
.nav-btn,
.marker-btn {
  border: none;
  border-radius: 14px;
  padding: 0.9rem 1.4rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  transition: transform 160ms ease, box-shadow 160ms ease, opacity 160ms ease;
}

.primary-btn,
.nav-btn {
  background: linear-gradient(135deg, #f8b85d, #d97139);
  color: #171515;
  box-shadow: 0 14px 28px rgba(235, 146, 70, 0.35);
}

.secondary-btn {
  background: rgba(36, 66, 105, 0.75);
  color: #ebf5ff;
  border: 1px solid rgba(228, 239, 255, 0.15);
}

.ghost-btn {
  background: transparent;
  color: #e5e7eb;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.primary-btn:hover,
.secondary-btn:hover,
.ghost-btn:hover,
.nav-btn:hover,
.marker-btn:hover {
  transform: translateY(-1px);
}

.primary-btn:focus-visible,
.secondary-btn:focus-visible,
.ghost-btn:focus-visible,
.nav-btn:focus-visible,
.marker-btn:focus-visible {
  outline: 3px solid rgba(94, 234, 212, 0.9);
  outline-offset: 3px;
}

.hero-visual {
  position: relative;
  min-height: 100%;
  background:
    linear-gradient(180deg, rgba(84, 59, 118, 0.28), rgba(60, 70, 88, 0.18)),
    linear-gradient(135deg, rgba(180, 82, 64, 0.25), rgba(19, 149, 168, 0.18));
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.preview-card {
  width: min(100%, 420px);
  height: min(74vh, 480px);
  border-radius: 22px;
  background: linear-gradient(180deg, rgba(18, 25, 40, 0.88), rgba(10, 17, 27, 0.88));
  border: 1px solid rgba(255,255,255,0.08);
  position: relative;
  box-shadow: inset 0 2px 0 rgba(255,255,255,.1), 0 26px 60px rgba(0,0,0,.4);
  overflow: hidden;
}

.preview-skyline,
.preview-road {
  position: absolute;
  inset: 0;
}

.preview-skyline {
  background: linear-gradient(180deg, rgba(80, 95, 120, 0.3), rgba(18, 24, 38, 0.92));
}

.preview-skyline::before,
.preview-skyline::after {
  content: "";
  position: absolute;
  bottom: 30%;
  width: 20%;
  height: 30%;
  background: rgba(38, 39, 65, 0.7);
  box-shadow: 18vw 0 rgba(59, 49, 83, 0.66), 42vw 8vh rgba(90, 85, 74, 0.74), 64vw 0 rgba(87, 99, 103, 0.82);
}

.preview-road {
  bottom: 0;
  height: 34%;
  background: linear-gradient(180deg, #363943, #1e222b 30%, #151b25 100%);
}

.preview-road::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: linear-gradient(90deg, transparent 0 7%, rgba(255,255,255,0.15) 7% 9%, transparent 9% 18%, rgba(255,255,255,0.15) 18% 20%, transparent 20% 31%, rgba(255,255,255,0.15) 31% 33%, transparent 33% 100%);
}

.preview-player {
  position: absolute;
  left: 50%;
  bottom: 26%;
  width: 70px;
  height: 86px;
  transform: translateX(-50%);
  border-radius: 20px 20px 16px 16px;
  background: linear-gradient(180deg, #f9ca72, #d97b46);
  box-shadow: inset 0 0 0 3px rgba(44, 19, 10, 0.16);
}

.preview-player::before,
.preview-player::after {
  content: "";
  position: absolute;
  background: #f2f0ea;
}

.preview-player::before {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  left: 21px;
  top: -18px;
}

.preview-player::after {
  width: 54px;
  height: 10px;
  border-radius: 999px;
  left: 8px;
  bottom: -20px;
  background: rgba(255,255,255,0.2);
}

.grid {
  display: grid;
  gap: 18px;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

.pill {
  padding: 0.5rem 0.8rem;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(143, 153, 175, 0.09);
  color: rgba(236, 242, 248, 0.84);
  font-size: 0.8rem;
}

.character-card-grid,
.reward-grid,
.mission-grid,
.settings-grid {
  display: grid;
  gap: 18px;
}

.character-card-grid {
  grid-template-columns: repeat(3, minmax(180px, 1fr));
}

.character-card,
.reward-card,
.mission-card,
.setting-card {
  background: rgba(13, 20, 30, 0.82);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 18px;
  padding: 16px;
}

.character-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.character-box {
  height: 150px;
  border-radius: 16px;
  background: linear-gradient(180deg, rgba(15, 17, 30, 0.7), rgba(18, 27, 45, 0.72));
  position: relative;
  overflow: hidden;
}

.character-body {
  position: absolute;
  left: 50%;
  bottom: 22px;
  width: 58px;
  height: 78px;
  border-radius: 20px;
  transform: translateX(-50%);
  background: linear-gradient(180deg, #ffd9ae, #d7774e);
}

.character-body::before {
  content: "";
  position: absolute;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  left: 16px;
  top: -18px;
  background: #f3dac6;
}

.character-card.locked {
  opacity: 0.56;
}

.character-card.selected {
  border-color: rgba(247, 184, 92, 0.6);
  box-shadow: 0 0 0 1px rgba(247,184,92,0.5);
}

.screen-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}

.screen-header h2 {
  margin: 0;
  font-size: clamp(1.7rem, 2vw, 2.4rem);
}

.hud {
  position: absolute;
  inset: 0;
  z-index: 30;
  pointer-events: none;
  opacity: 0;
  transition: opacity 200ms ease;
}

.hud.visible {
  opacity: 1;
}

.hud-top {
  position: absolute;
  top: 16px;
  left: 16px;
  right: 16px;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16px;
}

.score-box {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  align-items: center;
}

.metric {
  min-width: 120px;
  background: rgba(11, 17, 29, 0.52);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 10px 12px;
  backdrop-filter: blur(10px);
}

.metric-label {
  display: block;
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(224, 231, 243, 0.7);
}

.metric-value {
  display: block;
  margin-top: 4px;
  font-size: 1.2rem;
  font-weight: 800;
}

.power-box {
  background: rgba(11, 17, 29, 0.55);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 10px 12px;
}

.chase-box {
  width: 220px;
  background: rgba(11, 17, 29, 0.52);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 14px;
  padding: 10px 12px;
}

.bar {
  width: 100%;
  height: 10px;
  border-radius: 999px;
  background: rgba(255,255,255,0.08);
  overflow: hidden;
}

.bar-fill {
  display: block;
  height: 100%;
  background: linear-gradient(90deg, #58d4b2, #f3c96a, #e76b4d);
  border-radius: inherit;
  width: 15%;
}

.hud-bottom {
  position: absolute;
  left: 50%;
  bottom: 18px;
  transform: translateX(-50%);
  display: flex;
  gap: 10px;
}

.hud-badge {
  border: 1px solid rgba(255,255,255,0.09);
  border-radius: 999px;
  background: rgba(13,18,28,0.46);
  padding: 0.45rem 0.8rem;
  color: rgba(239, 242, 245, 0.8);
  font-size: 0.85rem;
}

.inline-controls {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.setting-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.setting-card label {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

input[type='range'] {
  width: 100%;
}

.mission-card h3,
.character-card h3,
.reward-card h3 {
  margin: 0;
}

.mini-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

canvas {
  display: block;
  width: 100%;
  height: 100%;
}

@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .character-card-grid {
    grid-template-columns: 1fr;
  }

  .screen {
    padding: 14px;
  }

  .panel {
    width: 100%;
    min-height: auto;
  }
}
